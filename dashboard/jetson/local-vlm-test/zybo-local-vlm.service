[Unit]
Description=Zybo demo local NVIDIA VLM API
After=basic.target

[Service]
Type=simple
WorkingDirectory=/home/jetson/local-vlm-test
Environment=HOME=/home/jetson
Environment=VLM_TEST_PORT=4188
Environment=VLM_MODEL_PORT=4190
ExecStartPre=/usr/bin/rm -f /home/jetson/local-vlm-test/runtime/app.pid /home/jetson/local-vlm-test/runtime/model-server.pid
ExecStart=/home/jetson/local-vlm-test/run-vlm-service.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=300
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
