From 6a932f68641634fcfd6ffabe1004ebc9e547b008 Mon Sep 17 00:00:00 2001
From: Pcam 5C integration <noreply@example.invalid>
Date: Sat, 1 Aug 2026 19:10:00 +0900
Subject: [PATCH] media: ov5640: use Digilent advanced AWB for Pcam 5C

The generic OV5640 initialization table leaves a strong magenta cast on the
Pcam 5C in direct 720p YUV mode.  Digilent's validated Pcam application
programs the advanced AWB thresholds after selecting the video mode.

Apply that exact table for the locally identified two-lane CSI-2 720p YUV
mode when automatic white balance is enabled.  Other sensors and modes keep
the upstream settings.

Signed-off-by: Pcam 5C integration <noreply@example.invalid>
---
 drivers/media/i2c/ov5640.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/media/i2c/ov5640.c b/drivers/media/i2c/ov5640.c
index 7d0131830c74..fbc8ac6e7034 100644
--- a/drivers/media/i2c/ov5640.c
+++ b/drivers/media/i2c/ov5640.c
@@ -630,6 +630,29 @@ static const struct reg_value ov5640_init_setting[] = {
 	{0x3a1f, 0x14, 0, 0}, {0x3008, 0x02, 0, 0}, {0x3c00, 0x04, 0, 300},
 };
 
+/* Digilent Pcam 5C advanced automatic-white-balance tuning. */
+static const struct reg_value ov5640_pcam_advanced_awb[] = {
+	{0x3406, 0x00, 0, 0},
+	{0x5192, 0x04, 0, 0},
+	{0x5191, 0xf8, 0, 0},
+	{0x518d, 0x26, 0, 0},
+	{0x518f, 0x42, 0, 0},
+	{0x518e, 0x2b, 0, 0},
+	{0x5190, 0x42, 0, 0},
+	{0x518b, 0xd0, 0, 0},
+	{0x518c, 0xbd, 0, 0},
+	{0x5187, 0x18, 0, 0},
+	{0x5188, 0x18, 0, 0},
+	{0x5189, 0x56, 0, 0},
+	{0x518a, 0x5c, 0, 0},
+	{0x5186, 0x1c, 0, 0},
+	{0x5181, 0x50, 0, 0},
+	{0x5184, 0x20, 0, 0},
+	{0x5182, 0x11, 0, 0},
+	{0x5183, 0x00, 0, 0},
+	{0x5001, 0x03, 0, 0},
+};
+
 static const struct reg_value ov5640_setting_low_res[] = {
 	{0x3c07, 0x08, 0, 0},
 	{0x3c09, 0x1c, 0, 0}, {0x3c0a, 0x9c, 0, 0}, {0x3c0b, 0x40, 0, 0},
@@ -2411,6 +2434,13 @@ static int ov5640_set_mode(struct ov5640_dev *sensor)
 	if (ret < 0)
 		return ret;
 
+	/* Match the validated Pcam application instead of generic OV5640 AWB. */
+	if (ov5640_is_digilent_720p_yuv(sensor) &&
+	    sensor->ctrls.auto_wb->val) {
+		ov5640_load_regs(sensor, ov5640_pcam_advanced_awb,
+				 ARRAY_SIZE(ov5640_pcam_advanced_awb));
+	}
+
 	sensor->pending_mode_change = false;
 	sensor->last_mode = mode;
 
-- 
