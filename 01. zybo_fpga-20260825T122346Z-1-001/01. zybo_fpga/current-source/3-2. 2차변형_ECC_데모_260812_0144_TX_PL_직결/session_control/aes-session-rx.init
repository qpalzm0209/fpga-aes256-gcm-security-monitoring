#!/bin/sh

DAEMON=${AES_SESSION_DAEMON:-/usr/bin/aes-session-agent}
WIFI_INIT=${AES_SESSION_WIFI_INIT:-/etc/init.d/aes-session-wifi}
RUN_DIR=${AES_SESSION_RUN_DIR:-/var/run}
if [ -n "${AES_SESSION_DATA_DIR:-}" ]; then
    DATA_DIR=$AES_SESSION_DATA_DIR
else
    # The root filesystem already provides the correct persistence semantics:
    # persistent on SD boot and intentionally volatile on JTAG/RAM boot.  Do
    # not depend on a card device name, volume label, or automount path.
    DATA_DIR=/var/lib/aes-session
fi
COUNTER_FILE=${AES_SESSION_COUNTER_FILE:-$DATA_DIR/rx-counter}
PIDFILE=$RUN_DIR/aes-session-agent-rx.pid
CHILD_PIDFILE=$RUN_DIR/aes-session-agent-rx.child.pid
WIFI_PIDFILE=$RUN_DIR/aes-session-wifi-rx.child.pid
STOPFILE=$RUN_DIR/aes-session-agent-rx.stop
INTERFACE_FILE=${AES_SESSION_WIFI_INTERFACE_FILE:-$RUN_DIR/aes-session-wifi.interface}
IDENTITY_FILE=${AES_SESSION_WIFI_IDENTITY_FILE:-$INTERFACE_FILE.identity}
LOGFILE=${AES_SESSION_LOGFILE:-/var/log/aes-session-agent-rx.log}
PRIVATE_KEY_FILE=${AES_SESSION_PRIVATE_KEY_FILE:-/etc/aes-session/rx-private.pem}
PEER_PUBLIC_KEY_FILE=${AES_SESSION_PEER_PUBLIC_KEY_FILE:-/etc/aes-session/tx-public.pem}
CONTROL_INTERFACE=${AES_SESSION_CONTROL_INTERFACE:-}
SYS_CLASS_NET=${AES_SESSION_SYS_CLASS_NET:-/sys/class/net}
RESTART_DELAY=${AES_SESSION_RESTART_DELAY:-2}
SELF=${AES_SESSION_INIT_SELF:-$0}

read_pid() {
    [ -r "$1" ] || return 1
    service_pid="$(cat "$1" 2>/dev/null)" || return 1
    case "$service_pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$service_pid" -gt 1 ] || return 1
    printf '%s\n' "$service_pid"
}

pidfile_is_alive() {
    checked_pid="$(read_pid "$1")" || return 1
    kill -0 "$checked_pid" 2>/dev/null
}

kill_if_alive() {
    [ -n "$1" ] || return 0
    kill -0 "$1" 2>/dev/null || return 0
    kill "$1" 2>/dev/null || true
}

wait_for_exit() {
    waited_pid="$1"
    attempts=0
    [ -n "$waited_pid" ] || return 0
    while kill -0 "$waited_pid" 2>/dev/null; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 5 ] || return 1
        sleep 1
    done
}

find_control_interface() {
    interface="$(cat "$INTERFACE_FILE" 2>/dev/null)" || return 1
    path="$SYS_CLASS_NET/$interface"
    # The USB Wi-Fi adapter is the authenticated key-exchange channel.  Never
    # fall back to the wired video NIC, a bridge, or a Tailscale/TUN device.
    [ -e "$path/device" ] && [ -d "$path/wireless" ] || return 1
    printf '%s\n' "$interface"
}

start_wifi_best_effort() {
    wifi_pid="$(read_pid "$WIFI_PIDFILE" 2>/dev/null || true)"
    if [ -n "$wifi_pid" ] && kill -0 "$wifi_pid" 2>/dev/null; then
        return 0
    fi
    rm -f "$WIFI_PIDFILE"
    "$WIFI_INIT" start rx &
    wifi_pid=$!
    printf '%s\n' "$wifi_pid" >"$WIFI_PIDFILE"
    echo "USB Wi-Fi key-exchange setup started"
}

stop_service() {
    mkdir -p "$RUN_DIR"
    : >"$STOPFILE"
    supervisor_pid="$(read_pid "$PIDFILE" 2>/dev/null || true)"
    child_pid="$(read_pid "$CHILD_PIDFILE" 2>/dev/null || true)"
    wifi_pid="$(read_pid "$WIFI_PIDFILE" 2>/dev/null || true)"

    # Marking STOPFILE before either signal prevents an agent exit from racing
    # the supervisor into another launch during a normal stop/restart.
    kill_if_alive "$supervisor_pid"
    kill_if_alive "$child_pid"
    kill_if_alive "$wifi_pid"

    wait_for_exit "$child_pid" || kill -KILL "$child_pid" 2>/dev/null || true
    wait_for_exit "$wifi_pid" || kill -KILL "$wifi_pid" 2>/dev/null || true
    wait_for_exit "$supervisor_pid" || kill -KILL "$supervisor_pid" 2>/dev/null || true
    rm -f "$PIDFILE" "$CHILD_PIDFILE" "$STOPFILE"
    kill -0 "$wifi_pid" 2>/dev/null || rm -f "$WIFI_PIDFILE"
}

supervise() {
    stopping=0

    terminate_current() {
        stopping=1
        : >"$STOPFILE"
        current_pid="$(read_pid "$CHILD_PIDFILE" 2>/dev/null || true)"
        wifi_pid="$(read_pid "$WIFI_PIDFILE" 2>/dev/null || true)"
        kill_if_alive "$current_pid"
        kill_if_alive "$wifi_pid"
        exit 0
    }

    cleanup_supervisor() {
        current_owner="$(read_pid "$PIDFILE" 2>/dev/null || true)"
        [ "$current_owner" != "$$" ] || rm -f "$PIDFILE"
        rm -f "$CHILD_PIDFILE" "$STOPFILE"
        wifi_pid="$(read_pid "$WIFI_PIDFILE" 2>/dev/null || true)"
        kill -0 "$wifi_pid" 2>/dev/null || rm -f "$WIFI_PIDFILE"
    }

    trap terminate_current TERM INT
    # Manual starts must survive logout just like starts performed by rcS.
    trap '' HUP
    trap cleanup_supervisor 0

    printf '%s\n' "$$" >"$PIDFILE"
    rm -f "$CHILD_PIDFILE"
    start_wifi_best_effort

    while [ ! -e "$STOPFILE" ]; do
        interface=$CONTROL_INTERFACE
        [ -n "$interface" ] || interface="$(find_control_interface 2>/dev/null || true)"
        if [ -z "$interface" ]; then
            start_wifi_best_effort
            echo "USB Wi-Fi key-exchange interface is unavailable; retrying"
            sleep "$RESTART_DELAY"
            continue
        fi
        if ! "$WIFI_INIT" health rx >/dev/null 2>&1; then
            start_wifi_best_effort
            echo "USB Wi-Fi key-exchange link is not ready; retrying"
            sleep "$RESTART_DELAY"
            continue
        fi

        "$DAEMON" --rx "$PRIVATE_KEY_FILE" "$PEER_PUBLIC_KEY_FILE" \
            --interface "$interface" --counter "$COUNTER_FILE" &
        current_pid=$!
        printf '%s\n' "$current_pid" >"$CHILD_PIDFILE"

        # A hot-unplugged USB Wi-Fi interface can leave the daemon alive on a
        # stale ifindex.  Poll link health so replugging the dongle causes both
        # the link and agent to be recreated with the newly discovered device.
        link_lost_file="$CHILD_PIDFILE.link-lost"
        rm -f "$link_lost_file"
        (
            while kill -0 "$current_pid" 2>/dev/null; do
                [ ! -e "$STOPFILE" ] || break
                if ! "$WIFI_INIT" health rx >/dev/null 2>&1; then
                    echo "USB Wi-Fi key-exchange link was lost; restarting link and session"
                    : >"$link_lost_file"
                    kill_if_alive "$current_pid"
                    break
                fi
                sleep "$RESTART_DELAY"
            done
        ) &
        health_pid=$!
        wait "$current_pid"
        daemon_status=$?
        kill_if_alive "$health_pid"
        wait "$health_pid" 2>/dev/null || true
        rm -f "$CHILD_PIDFILE"

        [ ! -e "$STOPFILE" ] || break
        if [ -e "$link_lost_file" ]; then
            rm -f "$link_lost_file"
            "$WIFI_INIT" restart rx || true
        fi
        echo "aes-session-agent exited (status $daemon_status); restarting in ${RESTART_DELAY}s"
        sleep "$RESTART_DELAY"
    done
}

start_service() {
    pidfile_is_alive "$PIDFILE" && return 0

    # Clean up an orphaned child left by an abruptly killed supervisor before
    # creating a replacement, so two agents can never own the same UDP port.
    stop_service
    mkdir -p "$DATA_DIR" "$RUN_DIR" "${LOGFILE%/*}"
    chmod 0700 "$DATA_DIR"
    rm -f "$STOPFILE" "$CHILD_PIDFILE"
    "$SELF" supervise >>"$LOGFILE" 2>&1 </dev/null &
    supervisor_pid=$!
    printf '%s\n' "$supervisor_pid" >"$PIDFILE"
}

case "$1" in
start) start_service ;;
stop) stop_service ;;
restart) stop_service; start_service ;;
status) pidfile_is_alive "$PIDFILE" ;;
supervise) supervise ;;
*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
